rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Quizzer profile: private to the authenticated owner.
    // Path: users/{userId}/profile/main
    function validQuizzerProfileWrite(data) {
      return data.keys().hasOnly(['first_name', 'last_name', 'avatar_id'])
        && data.first_name is string
        && data.first_name.size() > 0
        && data.last_name is string
        && data.last_name.size() > 0
        && (data.avatar_id == null || data.avatar_id is string);
    }

    // Official season curriculum (ADR-015).
    // Known paths require an authenticated client. All client writes are denied.
    // Admin content tooling uses the Admin SDK and bypasses these rules.
    // No entitlement, season-status, role, or project-id checks in this slice.
    function canReadCurriculum() {
      return isSignedIn();
    }

    match /seasons/{seasonId} {
      allow read: if canReadCurriculum();
      allow write: if false;

      // Transitional flat cards until Slice 6. Same policy as nested cards.
      match /cards/{cardId} {
        allow read: if canReadCurriculum();
        allow write: if false;
      }

      match /materialSets/{materialSetId} {
        allow read: if canReadCurriculum();
        allow write: if false;

        match /sections/{sectionId} {
          allow read: if canReadCurriculum();
          allow write: if false;
        }

        match /cards/{cardId} {
          allow read: if canReadCurriculum();
          allow write: if false;
        }
      }
    }

    match /users/{userId} {
      match /profile/{profileId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && profileId == 'main'
          && validQuizzerProfileWrite(request.resource.data);

        // Phase 6: owner may update only first_name and last_name (Edit Name).
        // avatar_id and document identity remain unchanged.
        allow update: if isOwner(userId)
          && profileId == 'main'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['first_name', 'last_name'])
          && request.resource.data.first_name is string
          && request.resource.data.first_name.size() > 0
          && request.resource.data.last_name is string
          && request.resource.data.last_name.size() > 0;

        allow delete: if false;
      }
    }

    // Phase 6.5A: parental consent is Functions/Admin only (ADR-008).
    match /parentalConsentRequests/{requestId} {
      allow read, write: if false;
    }

    match /parentalConsentRateLimits/{bucketId} {
      allow read, write: if false;
    }

    // Phase 8: feedback is Functions/Admin only (ADR-012). No client UID field.
    match /feedbackSubmissions/{submissionId} {
      allow read, write: if false;
    }
  }
}
