# Development — copy to .env.local for local Expo work.
# PROJECT_ID is the known dev project. Fill remaining client identifiers from
# Firebase Console → Project settings → Your apps. Do not commit the filled file.

EXPO_PUBLIC_IGNITE_ENV=dev
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=wpf-bible-qizzing
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
