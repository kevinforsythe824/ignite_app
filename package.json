{
  "name": "ignite_app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/bottom-tabs": "^7.18.15",
    "@react-navigation/native": "^7.3.15",
    "@react-navigation/native-stack": "^7.18.7",
    "expo": "~57.0.9",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.17.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.2",
    "exceljs": "^4.4.0",
    "expo-asset": "~57.0.8",
    "firebase-admin": "^14.2.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "test-renderer": "^1.2.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:ci": "jest --watchAll=false --ci",
    "test:firestore-rules": "PATH=\"/usr/local/opt/openjdk@21/bin:${PATH}\" JAVA_HOME=\"/usr/local/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home\" npx -y firebase-tools@14.26.0 emulators:exec --only firestore --project ignite-rules-test \"jest --config jest.firestore-rules.config.js --watchAll=false\"",
    "test:functions": "npm --prefix functions run test",
    "test:functions:integration": "PATH=\"/usr/local/opt/openjdk@21/bin:${PATH}\" JAVA_HOME=\"/usr/local/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home\" PARENT_EMAIL_HMAC_SECRET=integration-test-hmac-secret CONSENT_TOKEN_SEAL_SECRET=integration-test-seal-secret IGNITE_ENV=dev RUN_CALLABLE_CLAIM_INTEGRATION=1 npm --prefix functions run build && PATH=\"/usr/local/opt/openjdk@21/bin:${PATH}\" JAVA_HOME=\"/usr/local/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home\" PARENT_EMAIL_HMAC_SECRET=integration-test-hmac-secret CONSENT_TOKEN_SEAL_SECRET=integration-test-seal-secret IGNITE_ENV=dev RUN_CALLABLE_CLAIM_INTEGRATION=1 npx -y firebase-tools@14.26.0 emulators:exec --only auth,firestore,functions --project wpf-bible-qizzing \"npm --prefix functions run test:integration\"",
    "functions:build": "npm --prefix functions run build",
    "deploy:consent:dev": "npx -y firebase-tools@latest deploy --only functions,hosting --project wpf-bible-qizzing",
    "consent:dev-create": "tsx scripts/consent/devCreateConsentRequest.ts",
    "fix:claim-invoker:dev": "bash scripts/consent/fixClaimInvokerDev.sh",
    "seed:firestore": "tsx scripts/firestore-seed/seedFirestore.ts",
    "content:validate-source": "tsx scripts/content-pipeline/cli/validateSourceCli.ts",
    "content:generate-package": "tsx scripts/content-pipeline/cli/generatePackageCli.ts",
    "content:validate-package": "tsx scripts/content-pipeline/cli/validatePackageCli.ts",
    "content:write-authoring-files": "tsx scripts/content-pipeline/cli/writeAuthoringFilesCli.ts",
    "content:import": "tsx scripts/content-import/cli/importCli.ts",
    "content:import:plan": "tsx scripts/content-import/cli/importCli.ts",
    "content:import:diff": "tsx scripts/content-import/cli/importCli.ts --dev-diff",
    "content:typecheck": "tsc --noEmit -p scripts/content-pipeline/tsconfig.json && tsc --noEmit -p scripts/content-import/tsconfig.json",
    "firebase:target": "npx -y firebase-tools@latest use",
    "firebase:use:dev": "npx -y firebase-tools@latest use dev",
    "firebase:use:staging": "npx -y firebase-tools@latest use staging"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/firestore-rules/",
      "/functions/"
    ]
  },
  "private": true
}
