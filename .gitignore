# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# IDE
.idea/

# Firebase emulator / local debug logs
firestore-debug.log
firebase-debug.log
firebase-debug.*.log
ui-debug.log

# local env files (keep committed *.example files)
.env
.env.*
!.env.example
!.env.*.example
functions/.env

# Firebase Admin / GCP credentials (never commit)
*firebase-adminsdk*.json
serviceAccount*.json
secrets/

# Firebase CLI cache
.firebase/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
