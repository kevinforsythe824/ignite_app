# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# IDE
.idea/

# Firebase emulator / local debug logs
firestore-debug.log
firebase-debug.log
firebase-debug.*.log
ui-debug.log

# Cursor debug session logs (keep .cursor/rules tracked)
.cursor/debug-*.log
.cursor/*.log

# local env files (keep committed *.example files)
.env
.env.*
!.env.example
!.env.*.example
functions/.env

# Firebase Admin / GCP credentials (never commit)
*firebase-adminsdk*.json
serviceAccount*.json
secrets/

# Firebase CLI cache
.firebase/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# User-maintained local authoring. Templates and synthetic fixtures stay tracked.
content/authoring/local/

# Locally generated real-season packages (2027, 2028, …).
# The synthetic golden package stays tracked. A later promotion may
# add an explicit exception or git add -f; do not do that in Phase 2A.2.
content/packages/*
!content/packages/README.md
!content/packages/dev-synthetic-s3/
!content/packages/dev-synthetic-s3/**
