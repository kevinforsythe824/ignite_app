# Copy the matching example to .env.local. Never commit .env.local or keys.

# Required. One of: dev | staging | prod
# There is no default. Production is never assumed.
EXPO_PUBLIC_IGNITE_ENV=

# Firebase JS SDK web app config (Firebase Console → Project settings → Your apps).
# These are client identifiers, not server credentials.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin seed script (local only; never commit the JSON key file)
# FIREBASE_PROJECT_ID must match the project for EXPO_PUBLIC_IGNITE_ENV when set.
# FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json
