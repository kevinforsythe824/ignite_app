# Local emulator / developer secrets for Cloud Functions.
# Copy to functions/.env and fill values. Never commit functions/.env.

# Required for HMAC parent-email abuse keys (use a long random secret in DEV).
PARENT_EMAIL_HMAC_SECRET=

# Ignite environment for local Functions (must match Firebase project when deploying).
IGNITE_ENV=dev

# Optional: set true only when App Check is configured for the project.
APP_CHECK_ENFORCE=false
