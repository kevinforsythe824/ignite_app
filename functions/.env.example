# Local emulator / developer secrets for Cloud Functions.
# Copy to functions/.env and fill values. Never commit functions/.env.

# Required for HMAC parent-email abuse keys (use a long random secret in DEV).
PARENT_EMAIL_HMAC_SECRET=

# Optional dedicated secrets (default: derived from PARENT_EMAIL_HMAC_SECRET locally).
# CONSENT_TOKEN_SEAL_SECRET=
# CONSENT_BROWSER_SESSION_SECRET=

# Ignite environment for local Functions (must match Firebase project when deploying).
IGNITE_ENV=dev

# Optional: set true only when App Check is configured for the project.
APP_CHECK_ENFORCE=false

# Deployed DEV only — never commit real keys. Prefer Secret Manager.
# RESEND_API_KEY=

# Non-secret mail/Hosting config (safe to set locally):
# CONSENT_EMAIL_FROM=Ignite DEV <onboarding@resend.dev>
# CONSENT_HOSTING_BASE_URL=https://wpf-bible-qizzing.web.app
# PRIVACY_POLICY_URL=https://wpf-bible-qizzing.web.app/privacy

# Backend-only Help & Feedback Google Sheets mirror (never expose to the mobile app).
# Missing spreadsheet ID skips the mirror; Firestore remains authoritative.
# DEV spreadsheet (Restricted): 1Onh_-HjxexQWy9EfsTT_YeBgGWihND7Ou1gP9g3YKhM
# FEEDBACK_SHEETS_SPREADSHEET_ID=
# FEEDBACK_SHEETS_WORKSHEET_NAME=Feedback
