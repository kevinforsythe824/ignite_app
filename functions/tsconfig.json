{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "ES2022",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "types": ["node", "jest"]
  },
  "include": ["src", "../src/features/season/domain", "../src/features/season/data"],
  "exclude": ["src/**/*.test.ts", "src/**/integration/**"]
}
