# Staging — copy to .env.local only when you intend to run against staging.
# Fill remaining client identifiers from Firebase Console for ignite-staging-01.
# Do not commit the filled file.

EXPO_PUBLIC_IGNITE_ENV=staging
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=ignite-staging-01
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
